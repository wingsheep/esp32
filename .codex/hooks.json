{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/sheep/Desktop/me/esp32/dist/wled.mjs running --owner esp32",
            "timeout": 5,
            "statusMessage": "WLED: running"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/sheep/Desktop/me/esp32/dist/wled.mjs review --owner esp32",
            "timeout": 5,
            "statusMessage": "WLED: review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/sheep/Desktop/me/esp32/.codex/hooks/post-tool-use.mjs",
            "timeout": 5,
            "statusMessage": "WLED: tool result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/sheep/Desktop/me/esp32/dist/wled.mjs finish --owner esp32 --off-after 3000",
            "timeout": 8,
            "statusMessage": "WLED: finish then off"
          }
        ]
      }
    ]
  }
}
